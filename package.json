{
  "name": "hugo-lynx-theme",
  "version": "1.5.0",
  "description": "Lynx theme for Hugo",
  "scripts": {
    "dev": "tailwindcss -i ./assets/css/main.css -o ./assets/css/compiled/main.css --watch",
    "build": "tailwindcss -i ./assets/css/main.css -o ./assets/css/compiled/main.css",
    "example": "hugo server --source exampleSite --themesDir ../.. --buildDrafts -b http://localhost/lynx/ -p 8008",
    "format": "oxfmt .",
    "release": "semantic-release",
    "lint": "yarn format --check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ffflorian/lynx.git"
  },
  "keywords": [
    "hugo",
    "hugo-theme",
    "tailwind",
    "dark-mode"
  ],
  "author": "James Panther",
  "license": "MIT",
  "private": true,
  "bugs": {
    "url": "https://github.com/ffflorian/lynx/issues"
  },
  "homepage": "https://github.com/ffflorian/lynx#readme",
  "devDependencies": {
    "@ffflorian/oxfmt-config": "1.3.0",
    "@ffflorian/semantic-release-config": "1.0.3",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/git": "11.0.1",
    "@tailwindcss/cli": "4.3.3",
    "@tailwindcss/typography": "0.5.20",
    "oxfmt": "0.73.0",
    "semantic-release": "25.0.9",
    "tailwindcss": "4.3.3"
  },
  "packageManager": "yarn@4.18.1"
}
